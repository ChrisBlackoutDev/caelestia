#!/usr/bin/env python3

"""Small, chat-only OpenRouter bridge for the Caelestia AI panel."""

from __future__ import annotations

import json
import os
import socket
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


ENDPOINT = "https://openrouter.ai/api/v1/chat/completions"


def load_settings() -> dict[str, Any]:
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    path = base / "caelestia" / "ai.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        value = {}
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"Could not read {path}: {error}") from error

    if not isinstance(value, dict):
        raise ValueError(f"{path} must contain a JSON object")
    return value


def normalise_content(content: Any) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            str(part.get("text", ""))
            for part in content
            if isinstance(part, dict) and part.get("type") == "text"
        ).strip()
    return ""


def request_chat(payload: dict[str, Any]) -> dict[str, Any]:
    settings = load_settings()
    api_key = str(settings.get("apiKey") or os.environ.get("OPENROUTER_API_KEY") or "").strip()
    if not api_key:
        raise ValueError("OpenRouter API key is not configured. Open the panel settings to add one.")

    model = str(payload.get("model") or settings.get("model") or "qwen/qwen-2.5-coder-32b-instruct").strip()
    messages = payload.get("messages")
    if not isinstance(messages, list) or not messages:
        raise ValueError("messages must be a non-empty array")

    clean_messages = []
    for message in messages:
        if not isinstance(message, dict):
            continue
        role = message.get("role")
        content = message.get("content")
        if role in {"system", "user", "assistant"} and isinstance(content, str) and content:
            clean_messages.append({"role": role, "content": content})
    if not clean_messages:
        raise ValueError("messages did not contain any usable chat entries")

    try:
        temperature = float(settings.get("temperature", 0.4))
    except (TypeError, ValueError):
        temperature = 0.4

    body = json.dumps(
        {"model": model, "messages": clean_messages, "temperature": temperature},
        ensure_ascii=False,
    ).encode("utf-8")
    request = urllib.request.Request(
        ENDPOINT,
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/ChrisBlackoutDev/caelestia",
            "X-Title": "Caelestia desktop assistant",
            "User-Agent": "caelestia-ai-panel/1.0",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            result = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")[:1000]
        raise ValueError(f"OpenRouter returned HTTP {error.code}: {detail}") from error
    except (urllib.error.URLError, TimeoutError, socket.timeout) as error:
        raise ValueError(f"OpenRouter request failed: {error}") from error
    except json.JSONDecodeError as error:
        raise ValueError("OpenRouter returned invalid JSON") from error

    try:
        content = normalise_content(result["choices"][0]["message"]["content"])
    except (KeyError, IndexError, TypeError) as error:
        detail = result.get("error") if isinstance(result, dict) else None
        raise ValueError(f"OpenRouter response did not contain a message: {detail or result}") from error
    if not content:
        raise ValueError("OpenRouter returned an empty message")

    return {"ok": True, "content": content, "model": result.get("model", model)}


def main() -> int:
    if len(sys.argv) > 1:
        result = {
            "ok": False,
            "error": "This desktop panel is chat-only; local command execution is disabled.",
        }
        print(json.dumps(result))
        return 1

    try:
        payload = json.loads(sys.stdin.readline() or "{}")
        if not isinstance(payload, dict):
            raise ValueError("request must be a JSON object")
        result = request_chat(payload)
    except (OSError, ValueError, json.JSONDecodeError) as error:
        result = {"ok": False, "error": str(error)}
        print(json.dumps(result, ensure_ascii=False))
        return 1

    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
